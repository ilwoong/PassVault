<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-03: 기기 백업과 기기 간 전송에서 앱 데이터를 전부 제외한다.
  allowBackup="false" 는 클라우드 백업을 막지만 Android 12+ 의
  기기 간 전송(device-transfer)은 이 파일로만 막을 수 있다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
